    "birth_certificate": {
      "fields": {
        "registration_number": { "type": "string", "sensitivity": "identifier" },
        "name_as_printed": { "type": "name", "sensitivity": "basic" },
        "date_of_birth": { "type": "date", "sensitivity": "personal" },
        "place_of_birth": { "type": "string", "sensitivity": "personal" },
        "issuing_authority": { "type": "string", "sensitivity": "basic" }
      },
      "entity_key": ["issuing_authority", "registration_number"]
    }
  },
  "mappings": {
    "passport": "ICAO Doc 9303 TD3",
    "national_id": "ICAO Doc 9303 TD1 where machine-readable"
  }
}
