{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmobiledocumentagent.org/schemas/v0.1/registry.schema.json",
  "title": "OMDA registries: checks, models and runtimes (§2, §6, §12)",
  "$defs": {
    "checkRegistry": {
      "type": "object",
      "required": ["registry", "version", "checks"],
      "properties": {
        "registry": { "const": "checks" },
        "version": { "type": "string" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "version", "kind", "algorithm", "test_vectors"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "version": { "type": "string" },
              "kind": { "enum": ["checksum", "structure", "cross_field", "consistency", "format"] },
              "lifts_to_verified": { "type": "boolean" },
              "algorithm": { "type": "string" },
              "reference": { "type": "string" },
              "test_vectors": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["input", "result"],
                  "properties": { "input": {}, "result": { "enum": ["pass", "fail"] } }
                }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "enum": ["consistency", "format"] } } },
                "then": { "properties": { "lifts_to_verified": { "const": false } } }
              }
            ]
          }
        }
      }
    },
    "modelRegistry": {
      "type": "object",
      "required": ["registry", "version", "models"],
      "properties": {
        "registry": { "const": "models" },
        "version": { "type": "string" },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model", "slots", "license", "metrics"],
            "properties": {
              "model": { "type": "string" },
              "slots": { "type": "array", "items": { "type": "string" } },
              "quant": { "type": "string" },
              "size_mb": { "type": "number" },
              "license": { "type": "string" },
              "metrics": { "type": "object", "description": "Published slot-test metrics (§12); empty until a suite run is submitted." }
            }
          }
        }
      }
    },
    "runtimeRegistry": {
      "type": "object",
      "required": ["registry", "version", "runtimes"],
      "properties": {
        "registry": { "const": "runtimes" },
        "version": { "type": "string" },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["runtime", "publisher", "version", "level", "tier", "manifest", "publisher_key", "kid"],
            "properties": {
              "runtime": { "type": "string" },
              "publisher": { "type": "string" },
              "version": { "type": "string" },
              "platforms": { "type": "array", "items": { "enum": ["android", "ios", "other"] } },
              "level": { "type": "string", "pattern": "^L[1-4]\\+?$" },
              "tier": { "enum": ["T1", "T2", "T3"] },
              "gaps": { "type": "integer", "minimum": 0 },
              "manifest": { "type": "string", "description": "Signed conformance manifest, relative to /registry (§12, OD-044)." },
              "publisher_key": { "type": "string", "description": "Publisher's P-256 public key (JWK), relative to /registry." },
              "kid": { "type": "string", "description": "RFC 7638 thumbprint of the publisher key; the JWS header's kid." },
              "run_at": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
